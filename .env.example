# Example environment configuration for capa-server
# Copy this to .env and adjust as needed

# Container Runtime
# Use 'docker' or 'podman' - set for compatibility with your system
CONTAINER_RUNTIME=podman

# Paths
CAPA_RULES_PATH=/app/rules
DATABASE_PATH=/app/data/capa.db
UPLOAD_DIR=/app/data/uploads
RESULTS_DIR=/app/data/results

# Configuration
MAX_FILE_SIZE_MB=100
DEBUG=false
